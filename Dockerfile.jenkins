FROM jenkins/jenkins:lts-jdk21

USER root

# Install Docker CLI and Helm from Debian repos
RUN apt-get update && apt-get install -y \
    curl \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# Install Helm
RUN apt-get update && apt-get install -y helm 2>/dev/null || \
    (curl -fsSL https://baltocdn.com/helm/signing.asc | gpg --dearmor -o /usr/share/keyrings/helm.gpg && \
     echo "deb [arch=amd64 signed-by=/usr/share/keyrings/helm.gpg] https://baltocdn.com/helm/stable/debian/ all main" \
     > /etc/apt/sources.list.d/helm-stable-debian.list && \
     apt-get update && apt-get install -y helm) || true

USER jenkins

# Install required Jenkins plugins
RUN jenkins-plugin-cli --plugins \
    git \
    workflow-aggregator \
    pipeline-stage-view \
    docker-workflow \
    docker-plugin \
    credentials-binding \
    github \
    github-branch-source \
    pipeline-github-lib \
    email-ext \
    mailer
